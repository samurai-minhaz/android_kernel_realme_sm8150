// samurai_audio_reroute.cpp (Optimized for A16 AIDL Stack)
#include <android-base/logging.h>
#include <fcntl.h>
#include <sys/ioctl.h>
#include <linux/soundcard.h>
#include <unistd.h>

int main(int argc, char** argv) {
    if (argc < 3) return 1;
    int fd = open("/dev/mixer", O_RDWR | O_CLOEXEC);
    if (fd < 0) {
        PLOG(ERROR) << "Failed to open mixer for samurai";
        return 1;
    }
    for (int i = 2; i < argc; i += 2) {
        int from = atoi(argv[i - 1]);
        int to = atoi(argv[i]);
        int val = (from << 8) | to;
        if (ioctl(fd, SOUND_MIXER_PRIVATE2, &val) < 0) {
            PLOG(ERROR) << "AD1848 reroute failed";
            close(fd);
            return 1;
        }
    }
    close(fd);
    return 0;
}

